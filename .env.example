# OpenAI-compatible endpoint for the model under test (vLLM, SGLang, HF TGI...).
# Include /v1. Never commit .env. Local servers may use a dummy key.
TARGET_MODEL=
TARGET_BASE_URL=http://127.0.0.1:8000/v1
TARGET_API_KEY=local
# HF revision or served weight id recorded in every run manifest.
TARGET_REVISION=

# Optional commercial API budget; fill before a paid run. The CLI refuses a
# remote endpoint when max_calls is unset.
API_BASE_URL=
API_KEY=
MAX_API_CALLS=0

# Hugging Face cache for the Linux data/training host.
HF_HOME=
HF_TOKEN=
